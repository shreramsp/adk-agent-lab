# Copy to .env and fill in your key from https://aistudio.google.com/apikey
# The same key is used by the agent (Gemini) and by MCP Toolbox (embeddings for search).
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key

# Local AlloyDB Omni from docker-compose.yml (dev-only credentials)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=shop
DB_USER=shopadmin
DB_PASSWORD=shoppass

# MCP Toolbox for this agent (run_toolbox.sh); port 5000 is used by the bug assistant
TOOLBOX_URL=http://127.0.0.1:5001/mcp

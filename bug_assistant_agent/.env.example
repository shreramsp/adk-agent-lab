# Copy to .env and fill in your key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key

# Local Postgres from docker-compose.yml (dev-only credentials, never use these in production)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=bugs
DB_USER=bugadmin
DB_PASSWORD=bugpass

# MCP Toolbox server URL (run_toolbox.sh serves it here)
TOOLBOX_URL=http://127.0.0.1:5000/mcp

# Read-only GitHub token for the GitHub MCP server (see README). Leave empty to skip GitHub.
GITHUB_TOKEN=

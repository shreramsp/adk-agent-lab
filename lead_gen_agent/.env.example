# Copy to .env and fill in your key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key

# Optional demo switch (restart adk web after changing):
#   unset             -> lead_gen_boss (chat + confirmation)
#   pattern_discovery -> run pipeline 1 directly, every inner agent visible
#   lead_generation   -> run pipeline 2 directly (needs pipeline 1 earlier in the session)
#   full              -> both pipelines back to back, every inner agent visible
# SHOW_FLOW=full
